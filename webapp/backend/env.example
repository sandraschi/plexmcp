# Plex connection (required for MCP tools)
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token-here

# CORS (frontend port)
CORS_ORIGINS=http://localhost:10741,http://127.0.0.1:10741

# Server (reservoir port per mcp-central-docs)
HOST=0.0.0.0
PORT=10740
RELOAD=true

# LLM (Ollama, LM Studio, or OpenAI-compatible)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=optional-for-openai

# Optional: light RAG over Plex metadata
# RAG_INDEX_ENABLED=false
# RAG_EMBED_MODEL=nomic-embed-text
