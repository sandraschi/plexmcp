# PlexMCP Environment Configuration
# Copy this file to .env and update with your actual values

# Plex Server Connection (Required)
PLEX_SERVER_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# Optional Basic Authentication (if configured on server)
PLEX_USERNAME=your_plex_username
PLEX_PASSWORD=your_plex_password

# Performance Settings
PLEX_TIMEOUT=30

# MCP Bridge: comma-separated URLs of remote MCP servers to proxy
# MCP_BRIDGE_URLS=http://127.0.0.1:10750/mcp,http://127.0.0.1:10752/mcp

# Development/Debug Settings
PLEX_DEBUG=0
