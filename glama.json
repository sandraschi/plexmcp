{
	"$schema": "https://glama.ai/mcp/schemas/server.json",
	"maintainers": ["sandraschi"],
	"name": "plex-mcp",
	"description": "FastMCP 3.4+ server for managing Plex Media Server with type-safe API, 20+ portmanteau tools, LanceDB RAG, and optional webapp.",
	"type": "mcp_server",
	"status": "beta",
	"framework": "FastMCP 3.4+",
	"tools": 20,
	"transport": ["stdio", "http"],
	"keywords": [
		"plex",
		"media-server",
		"streaming",
		"video",
		"audio",
		"mcp-server",
		"fastmcp",
		"media-management",
		"rag"
	],
	"features": {
		"server_management": {
			"enabled": true
		},
		"media_browsing": {
			"enabled": true
		},
		"playback_control": {
			"enabled": true
		},
		"session_management": {
			"enabled": true
		},
		"semantic_search": {
			"enabled": true
		}
	}
}
