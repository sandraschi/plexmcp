{
  "name": "plex-mcp",
  "version": "2.0.0",
  "type": "server",
  "runtime": "python",
  "entry_point": "src/plex_mcp/main.py",
  "dependencies": [
    "fastmcp>=2.14.4,<3.0.0",
    "plexapi>=4.15.0",
    "requests>=2.31.0"
  ],
  "build": {
    "include": [
      "src/**/*",
      "README.md",
      "LICENSE",
      "manifest.json"
    ],
    "exclude": [
      "tests/",
      ".git/",
      "__pycache__/",
      "*.pyc",
      ".venv/",
      "dist/",
      "build/",
      "target/",
      "docs/",
      "scripts/",
      "logs/",
      ".cursor/",
      ".windsurf/",
      ".pytest_cache/",
      ".coverage"
    ]
  },
  "scripts": {
    "build": "mcpb build",
    "pack": "mcpb pack . dist/plex-mcp.mcpb",
    "test": "python -m pytest"
  }
}