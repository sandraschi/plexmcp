{

  "name": "plex-mcp",

  "version": "2.3.1",

  "type": "server",

  "runtime": "python",

  "entry_point": "src/plex_mcp/server.py",

  "dependencies": [

    "fastmcp>=3.1",

    "aiohttp>=3.9.0,<4.0.0",

    "aiofiles>=23.2.0,<24.0.0",

    "plexapi>=4.15.0",

    "pydantic>=2.0.0,<3.0.0",

    "python-dotenv>=1.0.0",

    "pyyaml>=6.0.0,<7.0.0",

    "requests>=2.31.0",

    "pytz>=2024.1",

    "jsonschema>=4.21.0"

  ],

  "build": {

    "include": [

      "src/**/*",

      "README.md",

      "LICENSE",

      "manifest.json"

    ],

    "exclude": [

      "tests/",

      ".git/",

      "__pycache__/",

      "*.pyc",

      ".venv/",

      "dist/",

      "build/",

      "target/",

      "docs/",

      "scripts/",

      "logs/",

      ".cursor/",

      ".windsurf/",

      ".pytest_cache/",

      ".coverage"

    ]

  },

  "scripts": {

    "build": "mcpb build",

    "pack": "mcpb pack . dist/plex-mcp.mcpb",

    "test": "python -m pytest"

  }

}