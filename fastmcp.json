{
  "name": "plex-mcp",
  "version": "3.2.0",
  "description": "Production-ready FastMCP 3.2 server for Plex Media Server with comprehensive error handling, monitoring, and 21 portmanteau tools",
  "source": {
    "type": "filesystem",
    "path": "src/plex_mcp/__main__.py",
    "object": "mcp"
  },
  "dependencies": [
    "fastmcp>=3.2.0",
    "aiohttp>=3.9.0,<4.0.0",
    "aiofiles>=23.2.0,<24.0.0",
    "plexapi>=4.15.0",
    "pydantic>=2.0.0,<3.0.0",
    "python-dotenv>=1.0.0",
    "pyyaml>=6.0.0,<7.0.0",
    "requests>=2.31.0",
    "pytz>=2024.1",
    "jsonschema>=4.21.0",
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "pydantic-settings>=2.0.0",
    "httpx>=0.25.0",
    "python-multipart>=0.0.6",
    "lancedb>=0.4.0",
    "sentence-transformers>=2.2.0"
  ],
  "include": [
    "src/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/CONFIGURATION.md",
    "docs/TOOLS.md",
    "docs/TROUBLESHOOTING.md",
    "deploy.ps1",
    "llms.txt"
  ],
  "exclude": [
    "tests/",
    ".git/",
    "__pycache__/",
    "*.pyc",
    ".venv/",
    "dist/",
    "build/",
    "target/",
    "docs-private/",
    "scripts/",
    "logs/",
    ".cursor/",
    ".windsurf/",
    ".pytest_cache/",
    ".coverage",
    "htmlcov/",
    "_llm_test_scripts/",
    "assets/",
    "webapp/",
    "config/",
    "data/"
  ]
}
